# ============================================================
# 复制为 .env.local（本地开发）或 .env（Docker）后填写
# ============================================================

# ---- Supabase（必填）----
# Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 仅服务端使用，切勿暴露到客户端；导入脚本也会用到
SUPABASE_SERVICE_ROLE_KEY=

# ---- 文本生成（可选，OpenAI 兼容接口）----
# 未配置时：生成 / 重新生成清单直接返回 503；翻译 / 归类 / 知识点不可用
# provider：deepseek（默认）/ openai / custom；只填 AI_MODEL 时也可按模型名推断
AI_PROVIDER=
AI_API_KEY=
# 完整接口地址（含 /chat/completions）；留空按 provider 取官方地址
AI_BASE_URL=
# 模型名；留空用 deepseek-flash / gpt-4o-mini
AI_MODEL=
# 例：兼容服务只需 AI_API_KEY + AI_BASE_URL + AI_MODEL
# 阿里云百炼：https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions + qwen-plus
# 智谱 GLM：https://open.bigmodel.cn/api/paas/v4/chat/completions + glm-4-flash
# 兼容旧变量：上面的 AI_* 为空时会读取 DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL / DEEPSEEK_MODEL
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

# ---- 微信读书（可选）----
# 缺失时：书库与清单中的「微信读书可读」入口自动隐藏
WEREAD_API_KEY=
WEREAD_SKILL_VERSION=

# ---- 语音合成（可选）----
# Edge TTS 需要本机 Python 解释器；留空则跳过
EDGE_TTS_PYTHON=
# 设为 1 可强制关闭 Edge TTS，回落到浏览器内置语音
EDGE_TTS_DISABLED=
# Azure Speech 为备选方案，两者都不配时仍可使用浏览器语音
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
