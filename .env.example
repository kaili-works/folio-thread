# ============================================================
# 复制为 .env.local（本地开发）或 .env（Docker）后填写
# ============================================================

# ---- Supabase（必填）----
# Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 仅服务端使用，切勿暴露到客户端；导入脚本也会用到
SUPABASE_SERVICE_ROLE_KEY=

# ---- DeepSeek 文本生成（可选）----
# 缺失时：清单走规则生成，翻译 / 归类 / 知识点功能提示不可用
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- 微信读书（可选）----
# 缺失时：书库与清单中的「微信读书可读」入口自动隐藏
WEREAD_API_KEY=
WEREAD_SKILL_VERSION=

# ---- 语音合成（可选）----
# Edge TTS 需要本机 Python 解释器；留空则跳过
EDGE_TTS_PYTHON=
# 设为 1 可强制关闭 Edge TTS，回落到浏览器内置语音
EDGE_TTS_DISABLED=
# Azure Speech 为备选方案，两者都不配时仍可使用浏览器语音
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
